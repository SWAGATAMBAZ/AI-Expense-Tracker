# Supabase — create a free project at https://supabase.com/dashboard,
# then copy these two values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — create a free account at https://openrouter.ai (no card
# required), then create an API key under Settings > Keys. Free models are
# $0/token; see .claude/specs/phase-05-06-ai-transaction-assistant.md for
# background on why free-tier models were chosen at all.
#
# openrouter/free is OpenRouter's own router: it picks a currently-available
# free model per request (filtered to ones that support the JSON structured
# output this app needs) instead of pinning to one specific model - a single
# :free model can go "temporarily rate-limited upstream" for everyone using
# it, all at once, with no warning, which pinning one model doesn't survive.
# Using it as both the primary and fallback gives two independent random
# picks (likely two different underlying models/providers) instead of one.
#
# All :free-tier usage (including via this router) shares one account-wide
# cap: 20 req/min always, 50 req/day normally, 1000 req/day after any
# lifetime $10+ credit purchase (openrouter.ai/settings/credits - the cap
# stays elevated even after the balance drops back toward $0). Nowhere near
# that ceiling for one demo user's occasional chat messages.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Public-demo prototype mode (optional). Set BOTH to auto-sign every visitor
# with no session of their own into this one shared Supabase account - no
# login screen, everyone sees/edits the same seeded data. Leave both unset
# for the normal, per-user authenticated app. See scripts/seed-test-user.mjs
# to create and seed the account these credentials point at.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
