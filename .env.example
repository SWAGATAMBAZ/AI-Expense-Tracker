# Supabase — create a free project at https://supabase.com/dashboard,
# then copy these two values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — create a free account at https://openrouter.ai (no card
# required), then create an API key under Settings > Keys. Free models are
# $0/token; see .claude/specs/phase-05-06-ai-transaction-assistant.md for
# why these two models were chosen.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
